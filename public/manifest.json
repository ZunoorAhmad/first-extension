{
  "manifest_version": 3,
  "name": "First Extension",
  "version": "1.0",
  "description": "A simple Chrome extension built with React.",
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
